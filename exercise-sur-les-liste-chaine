
#include <stdio.h>
#include <stdlib.h>

// ===== Structures =====
typedef struct Node {
    int data;
    struct Node *next;
} Node;

typedef struct DNode {
    int data;
    struct DNode *prev;
    struct DNode *next;
} DNode;

// ====== Fonctions utilitaires ======
Node* createNode(int val) {
    Node *n = malloc(sizeof(Node));
    n->data = val;
    n->next = NULL;
    return n;
}

DNode* createDNode(int val) {
    DNode *n = malloc(sizeof(DNode));
    n->data = val;
    n->prev = n->next = NULL;
    return n;
}

void afficherListe(Node *head) {
    printf("Liste: ");
    while (head != NULL) {
        printf("%d -> ", head->data);
        head = head->next;
    }
    printf("NULL\n");
}

void afficherDListe(DNode *head) {
    printf("Liste double: ");
    while (head != NULL) {
        printf("%d <-> ", head->data);
        head = head->next;
    }
    printf("NULL\n");
}

// ===== 1. Supprimer toutes les occurrences =====
void supprimerOcc(Node **head, int val) {
    Node *temp = *head, *prev = NULL;
    while (temp != NULL) {
        if (temp->data == val) {
            if (prev == NULL) {
                *head = temp->next;
            } else {
                prev->next = temp->next;
            }
            Node *aSup = temp;
            temp = temp->next;
            free(aSup);
        } else {
            prev = temp;
            temp = temp->next;
        }
    }
}

// ===== 2. Insertion triée (simplement chaînée) =====
void insererTrieSimple(Node **head, int val) {
    Node *newNode = createNode(val);
    if (*head == NULL || (*head)->data >= val) {
        newNode->next = *head;
        *head = newNode;
        return;
    }
    Node *temp = *head;
    while (temp->next != NULL && temp->next->data < val) {
        temp = temp->next;
    }
    newNode->next = temp->next;
    temp->next = newNode;
}

// ===== 3. Insertion triée (doublement chaînée) =====
void insererTrieDouble(DNode **head, int val) {
    DNode *newNode = createDNode(val);
    if (*head == NULL || (*head)->data >= val) {
        newNode->next = *head;
        if (*head != NULL) (*head)->prev = newNode;
        *head = newNode;
        return;
    }
    DNode *temp = *head;
    while (temp->next != NULL && temp->next->data < val) {
        temp = temp->next;
    }
    newNode->next = temp->next;
    if (temp->next != NULL) temp->next->prev = newNode;
    temp->next = newNode;
    newNode->prev = temp;
}

// ===== 4. Liste simplement chaînée circulaire =====
void insererTeteCirculaire(Node **head, int val) {
    Node *newNode = createNode(val);
    if (*head == NULL) {
        *head = newNode;
        newNode->next = newNode;
        return;
    }
    Node *temp = *head;
    while (temp->next != *head) temp = temp->next;
    newNode->next = *head;
    temp->next = newNode;
    *head = newNode;
}

void insererQueueCirculaire(Node **head, int val) {
    Node *newNode = createNode(val);
    if (*head == NULL) {
        *head = newNode;
        newNode->next = newNode;
        return;
    }
    Node *temp = *head;
    while (temp->next != *head) temp = temp->next;
    temp->next = newNode;
    newNode->next = *head;
}

// ===== 5. Liste doublement chaînée circulaire =====
void insererTeteDC(DNode **head, int val) {
    DNode *newNode = createDNode(val);
    if (*head == NULL) {
        newNode->next = newNode->prev = newNode;
        *head = newNode;
        return;
    }
    DNode *last = (*head)->prev;
    newNode->next = *head;
    newNode->prev = last;
    last->next = newNode;
    (*head)->prev = newNode;
    *head = newNode;
}

void insererQueueDC(DNode **head, int val) {
    DNode *newNode = createDNode(val);
    if (*head == NULL) {
        newNode->next = newNode->prev = newNode;
        *head = newNode;
        return;
    }
    DNode *last = (*head)->prev;
    newNode->next = *head;
    newNode->prev = last;
    last->next = newNode;
    (*head)->prev = newNode;
}

// ===== Main avec menu =====
int main() {
    Node *listeSimple = NULL, *listeCirculaire = NULL;
    DNode *listeDouble = NULL, *listeDoubleCirc = NULL;
    int choix, val;

    do {
        printf("\n===== MENU =====\n");
        printf("1. Supprimer toutes les occurrences dans une liste simple\n");
        printf("2. Insertion triée dans une liste simplement chaînée\n");
        printf("3. Insertion triée dans une liste doublement chaînée\n");
        printf("4. Insertion en tete/queue (liste circulaire simple)\n");
        printf("5. Insertion en tete/queue (liste circulaire double)\n");
        printf("0. Quitter\n");
        printf("Votre choix: ");
        scanf("%d", &choix);

        switch(choix) {
            case 1:
                printf("Valeur à insérer (liste simple triée pour test): ");
                scanf("%d", &val);
                insererTrieSimple(&listeSimple, val);
                afficherListe(listeSimple);
                printf("Valeur à supprimer: ");
                scanf("%d", &val);
                supprimerOcc(&listeSimple, val);
                afficherListe(listeSimple);
                break;

            case 2:
                printf("Valeur à insérer dans liste simple triée: ");
                scanf("%d", &val);
                insererTrieSimple(&listeSimple, val);
                afficherListe(listeSimple);
                break;

            case 3:
                printf("Valeur à insérer dans liste double triée: ");
                scanf("%d", &val);
                insererTrieDouble(&listeDouble, val);
                afficherDListe(listeDouble);
                break;

            case 4:
                printf("Insertion circulaire simple: \n1 = tete, 2 = queue: ");
                int opt1;
                scanf("%d", &opt1);
                printf("Valeur: ");
                scanf("%d", &val);
                if (opt1 == 1) insererTeteCirculaire(&listeCirculaire, val);
                else insererQueueCirculaire(&listeCirculaire, val);
                printf("Liste circulaire simple insérée (affichage partiel): %d\n", listeCirculaire->data);
                break;

            case 5:
                printf("Insertion circulaire double: \n1 = tete, 2 = queue: ");
                int opt2;
                scanf("%d", &opt2);
                printf("Valeur: ");
                scanf("%d", &val);
                if (opt2 == 1) insererTeteDC(&listeDoubleCirc, val);
                else insererQueueDC(&listeDoubleCirc, val);
                printf("Liste circulaire double insérée (affichage partiel): %d\n", listeDoubleCirc->data);
                break;

            case 0:
                printf("Au revoir!\n");
                break;

            default:
                printf("Choix invalide.\n");
        }

    } while(choix != 0);

    return 0;
}
